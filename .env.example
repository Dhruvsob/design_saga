# Use letters and numbers only here so the credentials are safe inside URLs.
POSTGRES_USER=designsaga
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
DB_NAME=design_saga

# Replace with the email that should receive the initial SuperAdmin role.
SUPER_ADMIN_EMAILS=you@example.com

# Production origins served by Caddy over HTTPS.
CORS_ORIGINS=https://gamaa.in,https://www.gamaa.in

# Prevent session cookies from being sent over unencrypted HTTP.
COOKIE_SECURE=true

# Optional. Leave blank unless AI/object-storage integrations are required.
EMERGENT_LLM_KEY=
