# Use letters and numbers only here so the credentials are safe inside URLs.
POSTGRES_USER=designsaga
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
DB_NAME=design_saga

# Replace with the email that should receive the initial SuperAdmin role.
SUPER_ADMIN_EMAILS=you@example.com

# Production origins served by Caddy over HTTPS.
CORS_ORIGINS=https://gamaa.in,https://www.gamaa.in

# Prevent session cookies from being sent over unencrypted HTTP.
COOKIE_SECURE=true

# Random 64+ character secret used to authenticate the append-only audit chain.
AUDIT_HMAC_KEY=replace_with_a_random_64_character_secret
BUSINESS_TIMEZONE=Asia/Kolkata
APP_BASE_URL=https://gamaa.in

# Optional Google Calendar tenant integration. Create one OAuth 2.0 Web client
# and register https://gamaa.in/api/calendar/google/callback as a redirect URI.
# The encryption key must be a random secret of at least 32 characters.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ENCRYPTION_KEY=
GOOGLE_CALENDAR_REDIRECT_URI=https://gamaa.in/api/calendar/google/callback

# Optional. Leave blank unless AI/object-storage integrations are required.
EMERGENT_LLM_KEY=
